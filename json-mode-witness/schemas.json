[
    {
        "id": "schema1",
        "prompt": "List the top 5 programming languages.",
        "schema": {
            "type": "object",
            "properties": {
                "languages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {"type": "string"},
                            "year_created": {"type": "number"},
                            "paradigm": {"type": "string"}
                        },
                        "required": ["name", "year_created", "paradigm"]
                    }
                }
            },
            "required": ["languages"]
        }
    },
    {
        "id": "schema2",
        "prompt": "Describe the capital of France.",
        "schema": {
            "type": "object",
            "properties": {
                "capital": {
                    "type": "string"
                }
            },
            "required": ["capital"]
        }
    }
]
